<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="12dp"
    android:background="@android:color/white"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Timestamp -->
        <TextView
            android:id="@+id/dateTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 2025-04-01 12:00"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="#DDDDDD" />

        <!-- Metric Rows (Icon + Text + Status) -->

        <!-- TEMP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_temperature"
                card_view:tint="#666" />

            <TextView
                android:id="@+id/tempText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Temperature: -- °C"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tempStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <!-- HUMIDITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_humidity"
                card_view:tint="#666" />

            <TextView
                android:id="@+id/humidityText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Humidity: -- %"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/humidityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <!-- CO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_co"
                card_view:tint="#666" />

            <TextView
                android:id="@+id/coText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CO: -- ppm"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/coStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <!-- LPG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_lpg"
                card_view:tint="#666" />

            <TextView
                android:id="@+id/lpgText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LPG: -- ppm"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/lpgStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <!-- NH₄ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_smoke"
                card_view:tint="#666" />

            <TextView
                android:id="@+id/smokeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NH₄: -- ppm"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/smokeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
